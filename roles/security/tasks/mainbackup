---
- name: Install security packages
  ansible.builtin.apt:
    name: "{{ security_packages }}"
    state: present
    update_cache: true
    cache_valid_time: 3600

# ============================================================
# FAIL2BAN
# ============================================================

- name: Check whether fail2ban service exists
  ansible.builtin.command:
    cmd: systemctl list-unit-files fail2ban.service
  register: fail2ban_service_check
  changed_when: false
  failed_when: false

- name: Ensure fail2ban is enabled and running
  ansible.builtin.systemd:
    name: fail2ban
    state: started
    enabled: true
  when:
    - security_enable_fail2ban | bool
    - "'fail2ban.service' in fail2ban_service_check.stdout"

# ============================================================
# AUDITD
# ============================================================

- name: Check whether auditd service exists
  ansible.builtin.command:
    cmd: systemctl list-unit-files auditd.service
  register: auditd_service_check
  changed_when: false
  failed_when: false

- name: Ensure auditd is enabled
  ansible.builtin.systemd:
    name: auditd
    enabled: true
  when:
    - security_enable_auditd | bool
    - "'auditd.service' in auditd_service_check.stdout"

- name: Ensure auditd is running
  ansible.builtin.service:
    name: auditd
    state: started
  when:
    - security_enable_auditd | bool
    - "'auditd.service' in auditd_service_check.stdout"

# ============================================================
# UNATTENDED SECURITY UPDATES
# ============================================================

- name: Enable unattended security updates
  ansible.builtin.copy:
    dest: /etc/apt/apt.conf.d/20auto-upgrades
    owner: root
    group: root
    mode: '0644'
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  when: security_enable_unattended_upgrades | bool

# ============================================================
# SSH HARDENING
# ============================================================

- name: Configure SSH root login
  ansible.builtin.lineinfile:
    path: /etc/ssh/sshd_config
    regexp: '^#?PermitRootLogin'
    line: "PermitRootLogin {{ ssh_permit_root_login }}"
    validate: '/usr/sbin/sshd -t -f %s'
  notify: Restart SSH

- name: Configure SSH password authentication
  ansible.builtin.lineinfile:
    path: /etc/ssh/sshd_config
    regexp: '^#?PasswordAuthentication'
    line: "PasswordAuthentication {{ ssh_password_authentication }}"
    validate: '/usr/sbin/sshd -t -f %s'
  notify: Restart SSH

- name: Configure SSH public key authentication
  ansible.builtin.lineinfile:
    path: /etc/ssh/sshd_config
    regexp: '^#?PubkeyAuthentication'
    line: "PubkeyAuthentication {{ ssh_pubkey_authentication }}"
    validate: '/usr/sbin/sshd -t -f %s'
  notify: Restart SSH
