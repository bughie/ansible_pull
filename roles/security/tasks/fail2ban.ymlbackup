---
- name: Ensure default security variables are loaded
  ansible.builtin.include_vars:
    file: roles/security/defaults/main.yml

- name: Ensure Fail2ban package is installed
  ansible.builtin.apt:
    name: fail2ban
    state: present

- name: Configure Fail2ban
  ansible.builtin.template:
    src: jail.local.j2
    dest: /etc/fail2ban/jail.local
    mode: '0644'
  notify: restart fail2ban

- name: Ensure Fail2ban service is running and enabled
  ansible.builtin.systemd:
    name: fail2ban
    state: started
    enabled: true
