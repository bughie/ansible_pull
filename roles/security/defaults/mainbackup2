---
# ==========================================
# 1. SSH Security (Prefixed for template compatibility)
# ==========================================
security_ssh_port: 22
security_ssh_permit_root_login: "no"
security_ssh_password_authentication: "no"
security_ssh_pubkey_authentication: "yes"

# Map old aliases if referenced elsewhere in your role
ssh_permit_root_login: "{{ security_ssh_permit_root_login }}"
ssh_password_authentication: "{{ security_ssh_password_authentication }}"
ssh_pubkey_authentication: "{{ security_ssh_pubkey_authentication }}"

# ==========================================
# 2. UFW Firewall
# ==========================================
security_enable_ufw: true
ufw_default_input_policy: "drop"
ufw_default_output_policy: "allow"
ufw_allowed_tcp_ports:
  - "22"

# ==========================================
# 3. Fail2ban
# ==========================================
security_enable_fail2ban: true
fail2ban_bantime: "1h"
fail2ban_findtime: "10m"
fail2ban_maxretry: 5

# ==========================================
# 4. Auditd
# ==========================================
security_enable_auditd: true

# ==========================================
# 5. Automatic Security Updates
# ==========================================
security_enable_unattended_upgrades: true

# ==========================================
# 6. Password Policy (PAM)
# ==========================================
security_enable_password_policy: true
pam_pwquality_minlen: 14
pam_pwquality_dcredit: -1
pam_pwquality_ucredit: -1
pam_pwquality_lcredit: -1
pam_pwquality_ocredit: -1
pass_max_days: 90
pass_min_days: 7
pass_warn_age: 14

# ==========================================
# 7. Sysctl Hardening
# ==========================================
security_enable_sysctl: true

# ==========================================
# 8. Filesystem Permissions
# ==========================================
security_enable_filesystem_hardening: true

# ==========================================
# Base Packages
# ==========================================
security_packages:
  - ufw
  - fail2ban
  - auditd
  - audispd-plugins
  - unattended-upgrades
  - libpam-pwquality
