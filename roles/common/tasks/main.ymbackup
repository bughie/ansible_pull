---
- name: Update APT cache
  ansible.builtin.apt:
    update_cache: true
    cache_valid_time: 3600

- name: Upgrade installed packages
  ansible.builtin.apt:
    upgrade: safe

- name: Install common administration packages
  ansible.builtin.apt:
    name:
      - ca-certificates
      - curl
      - wget
      - git
      - vim
      - nano
      - unzip
      - zip
      - rsync
      - jq
      - tree
      - tmux
      - htop
      - btop
      - lsof
      - net-tools
      - dnsutils
      - bash-completion
    state: present

- name: Set timezone
  community.general.timezone:
    name: "{{ system_timezone }}"

- name: Install chrony
  ansible.builtin.apt:
    name: chrony
    state: present

- name: Check chrony service
  ansible.builtin.systemd_service:
    name: chrony
    daemon_reload: true
  register: chrony_service_check
  failed_when: false
  changed_when: false

- name: Ensure chrony is enabled and running
  ansible.builtin.systemd_service:
    name: chrony
    state: started
    enabled: true
  when: 
    - chrony_service_check.status is defined
    - not ansible_check_mode
